{
  "expo": {
    "name": "Crew Performance Evaluator",
    "slug": "crew-performance-evaluator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B3A5C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crewperformance.evaluator",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to add employee photos.",
        "NSCameraUsageDescription": "This app needs access to your camera to take employee photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B3A5C"
      },
      "package": "com.crewperformance.evaluator",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-image-picker",
      "expo-sqlite"
    ]
  }
}
